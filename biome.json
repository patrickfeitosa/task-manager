{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ["react", "react-*"],
              ":BLANK_LINE:",
              ["next", "next/**"],
              ":BLANK_LINE:",
              "@tanstack/**",
              ":BLANK_LINE:",
              "@testing-library/**",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ["@Api/**", "@Schemas/**", "@Server/**"],
              ":BLANK_LINE:",
              ["@Ui/**", "@Domain/**", "@Components/**"],
              ":BLANK_LINE:",
              ["@Hooks/**", "@Libs/**", "@I18n", "@I18n/**", "@Test/**", "@Types/**", "@/**"],
              ":BLANK_LINE:",
              ":PATH:",
              ":BLANK_LINE:",
              "@Styles/**"
            ]
          }
        },
        "useSortedAttributes": "on",
        "useSortedKeys": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/node_modules",
      "!**/storybook-static",
      "!**/public",
      "!**/test-results",
      "!**/playwright-report",
      "!**/coverage",
      "!**/yarn.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "performance": {
        "noReExportAll": "error"
      },
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../*", "../**"],
                "message": "Use an alias (@Ui, @Hooks, @Libs, ...) instead of ../ imports. ./ is only for a module's own siblings."
              }
            ]
          }
        }
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
