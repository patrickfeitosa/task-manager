# Copy to .env.local (git-ignored) and uncomment what you need. Nothing here is required.

# Start the in-memory store with 25 fictional sample tasks (default: empty).
# Same as `yarn dev:seed`, but works in any shell.
# SEED_TASKS=true

# Port used by Playwright's web server and base URL (default: 3000).
# E2E_PORT=3000
